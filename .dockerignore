# Build outputs — regenerated inside the image (and stale host artifacts must not leak in).
**/bin/
**/obj/

# Version control, IDE, and local tooling state.
.git/
.github/
.vs/
.vscode/
.idea/
.claude/
*.user

# Large trees the examples build does not need (keep ext/, src/, examples/, docs/).
reference/
tests/
BenchmarkDotNet.Artifacts/
# id Software game assets. GameData/.gitignore keeps these out of git, but Docker build contexts do not
# read .gitignore -- and Dockerfile does `COPY . .`, so without this a machine that has the files would bake
# non-redistributable assets into a pushed image.
examples/Jumbee.Console.Wolf3DDemo/GameData/*
!examples/Jumbee.Console.Wolf3DDemo/GameData/README.md

# Packed .nupkg output (pack.ps1). The demos build from source, so shipping the packages would only bloat the image
# and bust the COPY cache on every release.
artifacts/

# The Docker build files themselves.
Dockerfile
.dockerignore
