<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Repo>C:\Projects\Jumbee.Console</Repo>
  </PropertyGroup>

  <ItemGroup>
    <!-- The demo's own sources, minus its Program.cs entry point. -->
    <Compile Include="$(Repo)\examples\Jumbee.Console.3DSandboxDemo\*.cs"
             Exclude="$(Repo)\examples\Jumbee.Console.3DSandboxDemo\Program.cs" />
  </ItemGroup>

  <!-- Same fork/vendored references examples/Directory.Build.props gives the real demo projects. -->
  <Import Project="C:\Projects\Jumbee.Console\src\ExternalReferences.props" />

  <ItemGroup>
    <PackageReference Include="Box3D.NET" Version="0.3.0" />
    <ProjectReference Include="$(Repo)\src\Jumbee.Console\Jumbee.Console.csproj" />
    <ProjectReference Include="$(Repo)\src\Jumbee.Console.Snapshot\Jumbee.Console.Snapshot.csproj" />
  </ItemGroup>

</Project>
