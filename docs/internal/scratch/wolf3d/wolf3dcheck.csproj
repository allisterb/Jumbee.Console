<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Repo>C:\Projects\Jumbee.Console</Repo>
  </PropertyGroup>
  <ItemGroup>
    <!-- The demo's own sources, minus its Program.cs entry point. -->
    <Compile Include="$(Repo)\examples\Jumbee.Console.Wolf3DDemo\*.cs"
             Exclude="$(Repo)\examples\Jumbee.Console.Wolf3DDemo\Program.cs" />
    <Compile Include="$(Repo)\examples\Jumbee.Console.Wolf3DDemo\engine\**\*.cs" />
  </ItemGroup>
  <Import Project="C:\Projects\Jumbee.Console\src\ExternalReferences.props" />
  <ItemGroup>
    <ProjectReference Include="$(Repo)\src\Jumbee.Console\Jumbee.Console.csproj" />
    <ProjectReference Include="$(Repo)\src\Jumbee.Console.Snapshot\Jumbee.Console.Snapshot.csproj" />
  </ItemGroup>
</Project>
