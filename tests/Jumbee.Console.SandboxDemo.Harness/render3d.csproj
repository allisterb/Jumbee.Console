<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>false</IsPackable>
    <!-- Derived from this file's own location, never hard-coded. An absolute path here is invisible to the build
         script's sln guard (which only inspects the .sln) and breaks every checkout but the author's. That is the
         failure that broke the Linux build for four days. -->
    <Repo>$(MSBuildThisFileDirectory)..\..</Repo>
  </PropertyGroup>

  <ItemGroup>
    <!-- The demo's own sources, minus its Program.cs entry point. Anything the demo gains (a package reference
         especially) has to be mirrored here, or this project stops compiling. That has happened twice. -->
    <Compile Include="$(Repo)\examples\Jumbee.Console.3DSandboxDemo\*.cs"
             Exclude="$(Repo)\examples\Jumbee.Console.3DSandboxDemo\Program.cs" />
  </ItemGroup>

  <!-- The fork/vendored references (src/ExternalReferences.props) come from tests/Directory.Build.props, as they do
       for every project under tests/. Importing them here as well is a duplicate MSBuild ignores with MSB4011. -->

  <ItemGroup>
    <PackageReference Include="Box3D.NET" Version="0.3.0" />
    <PackageReference Include="Ply.Net" Version="5.6.3" />
    <PackageReference Include="PngSharp" Version="0.6.0" />
    <PackageReference Include="BitMiracle.LibJpeg.NET" Version="1.5.324" />
    <ProjectReference Include="$(Repo)\src\Jumbee.Console\Jumbee.Console.csproj" />
    <ProjectReference Include="$(Repo)\src\Jumbee.Console.Snapshot\Jumbee.Console.Snapshot.csproj" />
  </ItemGroup>

</Project>
