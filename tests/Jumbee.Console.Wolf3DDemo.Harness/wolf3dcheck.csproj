<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>false</IsPackable>
    <!-- See the note in the sandbox harness: derived, never hard-coded. -->
    <Repo>$(MSBuildThisFileDirectory)..\..</Repo>
  </PropertyGroup>

  <ItemGroup>
    <!-- The demo's own sources, minus its Program.cs entry point. -->
    <Compile Include="$(Repo)\examples\Jumbee.Console.Wolf3DDemo\*.cs"
             Exclude="$(Repo)\examples\Jumbee.Console.Wolf3DDemo\Program.cs" />
    <Compile Include="$(Repo)\examples\Jumbee.Console.Wolf3DDemo\engine\**\*.cs" />
  </ItemGroup>

  <!-- src/ExternalReferences.props comes from tests/Directory.Build.props; importing it here too is MSB4011. -->

  <ItemGroup>
    <ProjectReference Include="$(Repo)\src\Jumbee.Console\Jumbee.Console.csproj" />
    <ProjectReference Include="$(Repo)\src\Jumbee.Console.Snapshot\Jumbee.Console.Snapshot.csproj" />
  </ItemGroup>

</Project>
