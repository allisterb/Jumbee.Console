<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Jumbee.Console.IdeDemo</AssemblyName>
    <RootNamespace>Jumbee.Console.IdeDemo</RootNamespace>
    <!-- PublishAot is per-project, not inherited: a plain `dotnet publish` on a project without it yields a
         framework-dependent apphost stub that crashes silently in an SDK-less image. See Dockerfile.aot. Trims clean
         (0 IL warnings), and its terminal pane was proven under AOT in a Linux container: a real shell, and a build
         run from the Build menu. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- The bundled sample project is DATA, not part of this app's compilation: exclude its sources from the compile
       glob and ship the whole folder as content copied next to the output, so the running IDE can open it and the
       user can `dotnet build`/`dotnet run` it. That needs a .NET SDK, which the Docker image does not carry: the Build
       menu offers to install one when none is found. -->
  <ItemGroup>
    <Compile Remove="SampleProject\**\*.cs" />
    <Content Include="SampleProject\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Jumbee.Console\Jumbee.Console.csproj" />
    <!-- Used only by the headless verify smoke check to render the layout offscreen. -->
    <ProjectReference Include="..\..\src\Jumbee.Console.Snapshot\Jumbee.Console.Snapshot.csproj" />
  </ItemGroup>

</Project>
