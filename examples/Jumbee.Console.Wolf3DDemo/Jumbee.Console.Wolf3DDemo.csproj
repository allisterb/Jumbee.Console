<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Jumbee.Console.Wolf3DDemo</RootNamespace>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Off for the project, matching upstream, because the vendored engine is net8.0-era code we have promised not
         to edit and it raises ~40 nullability warnings. `Nullable` is a project-level property with no per-file
         equivalent, so the demo's own files opt back IN with a `#nullable enable` line each: that keeps this
         project's code null-checked without a single edit to engine/. -->
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Jumbee.Console\Jumbee.Console.csproj" />
    <!-- For the `verify` smoke check only, as the IDE demo and the agent harness do: laying the tree out offscreen is
         the only way to draw a frame without a terminal, and the viewport has no size (so renders nothing) until it has. -->
    <ProjectReference Include="..\..\src\Jumbee.Console.Snapshot\Jumbee.Console.Snapshot.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="GameData\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
