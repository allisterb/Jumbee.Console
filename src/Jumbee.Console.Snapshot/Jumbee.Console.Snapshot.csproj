<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyVersion>$(ProjectAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(ProjectAssemblyVersion)</FileVersion>
    <Version>$(ProjectAssemblyVersion)</Version>
  </PropertyGroup>

  <!-- Add-on package: headless snapshot testing (render controls to text/PNG without a terminal). Depends on the
       core Jumbee.Console package plus its own NuGet dependencies (SixLabors ImageSharp/Fonts). -->
  <PropertyGroup Label="Packaging">
    <IsPackable>true</IsPackable>
    <!-- For republishing THIS package alone (e.g. 0.2.1.1, a README-only fix): pack with -p:SnapshotPackageVersion=x.
         Not with -p:PackageVersion=x, because a global property also reaches the referenced Jumbee.Console project,
         so the package would depend on a Jumbee.Console x that does not exist. Only this project reads this one. -->
    <PackageVersion Condition="'$(SnapshotPackageVersion)' != ''">$(SnapshotPackageVersion)</PackageVersion>
    <PackageReadmeFile>README.Snapshot.md</PackageReadmeFile>
    <Description>Headless snapshot testing for Jumbee.Console TUIs: render controls to text or PNG without a real terminal, for unit tests and visual verification.</Description>
  </PropertyGroup>

  <ItemGroup Label="Packaging">
    <None Include="..\..\package\README.Snapshot.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jumbee.Console\Jumbee.Console.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.6" />
    <PackageReference Include="SixLabors.Fonts" Version="2.1.3" />
  </ItemGroup>

</Project>
