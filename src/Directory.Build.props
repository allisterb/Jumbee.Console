<Project>
  <PropertyGroup Label="Settings">
    <Deterministic>false</Deterministic>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <NoWarn>NETSDK1233</NoWarn>
  </PropertyGroup>

  <!-- Shared assembly version for the Jumbee.Console libraries. Projects opt in by mapping their AssemblyVersion /
       FileVersion / Version to this property, so bumping the version here restamps them all on the next build. -->
  <PropertyGroup Label="Versioning">
    <ProjectAssemblyVersion>0.1.10</ProjectAssemblyVersion>
  </PropertyGroup>

  <!-- Shared NuGet package metadata. Projects are NOT packed by default; the shipped libraries
       (Jumbee.Console core + the Documents/Snapshot add-ons) opt in with <IsPackable>true</IsPackable>. -->
  <PropertyGroup Label="Packaging">
    <IsPackable>false</IsPackable>
    <Authors>Allister Beharry</Authors>
    <Company>Allister Beharry</Company>
    <Product>Jumbee.Console</Product>
    <Copyright>Copyright (c) 2026 Allister Beharry</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/allisterb/Jumbee.Console</PackageProjectUrl>
    <RepositoryUrl>https://github.com/allisterb/Jumbee.Console</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>logo.png</PackageIcon>
    <PackageTags>tui;terminal;console;ansi;ui;jumbee</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageVersion>$(ProjectAssemblyVersion)</PackageVersion>
    <!-- Debug symbols travel inside the assembly rather than as a separate symbols package. A .snupkg only reaches
         consumers who have enabled the NuGet.org symbol server; an embedded PDB needs no configuration at all, and
         it survives the bundling target that copies assemblies into lib/. SourceLink maps the recorded paths to
         this repo on GitHub, so stepping in shows the real source — comments included — at the exact commit.
         Note this is NOT paired with ContinuousIntegrationBuild/deterministic builds: see Deterministic above. -->
    <DebugType>embedded</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- NuGet release notes: the repo CHANGELOG.txt is packed as the release notes for all three shipped packages.
         Update CHANGELOG.txt each release (newest entry on top); the Exists guard keeps the build working if it's
         ever absent. It is plain text, not Markdown, and the extension is deliberate: nuget.org and the Visual
         Studio package manager show release notes as plain text, and GitHub renders a .txt verbatim rather than
         trying to interpret it as Markdown. -->
    <PackageReleaseNotes Condition="Exists('$(MSBuildThisFileDirectory)../CHANGELOG.txt')">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../CHANGELOG.txt'))</PackageReleaseNotes>
  </PropertyGroup>

  <!-- Shared package icon (the same logo for all three packages). Harmless on non-packable projects (only used
       at pack time). The per-package README is packed by each shipped project (README.md source differs). -->
  <ItemGroup Label="Packaging">
    <None Include="$(MSBuildThisFileDirectory)..\package\logo.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Give the other src/ libraries (Documents, Snapshot, TestDemo, ...) the fork/vendored references they need to
       compile against Jumbee.Console's public API. Excluded: Jumbee.Console (imports this itself) and
       Jumbee.Console.Styles (owns a subset of these references directly). -->
  <Import Project="$(MSBuildThisFileDirectory)ExternalReferences.props"
          Condition="'$(MSBuildProjectName)' != 'Jumbee.Console' and '$(MSBuildProjectName)' != 'Jumbee.Console.Styles'" />
</Project>